{
  "name": "steady-path",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "api": "node server/index.mjs",
    "start": "expo start",
    "start:dev": "cross-env EXPO_PUBLIC_APP_ENV=development expo start --dev-client",
    "android": "expo run:android",
    "android:dev": "cross-env EXPO_PUBLIC_APP_ENV=development expo run:android --variant debug",
    "android:release": "cross-env EXPO_PUBLIC_APP_ENV=production expo run:android --variant release",
    "build:android:dev": "eas build --platform android --profile development",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:prod": "eas build --platform android --profile production",
    "submit:android:prod": "eas submit --platform android --profile production",
    "ios": "expo run:ios",
    "ios:dev": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.8",
    "@react-navigation/native": "^7.2.1",
    "@types/react": "~19.1.10",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "expo": "^54.0.0",
    "expo-av": "~16.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-notifications": "~0.32.16",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "express": "^5.2.1",
    "openai": "^6.33.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webrtc": "^124.0.7"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "cross-env": "^10.1.0",
    "eas-cli": "^18.4.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
