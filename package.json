{
  "name": "steady-path",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "api": "bun server/src/index.ts",
    "api:watch": "bun --watch server/src/index.ts",
    "start": "expo start",
    "start:dev": "cross-env EXPO_PUBLIC_APP_ENV=development expo start --dev-client",
    "android": "expo run:android",
    "android:dev": "cross-env EXPO_PUBLIC_APP_ENV=development expo run:android --variant debug",
    "android:release": "cross-env EXPO_PUBLIC_APP_ENV=production expo run:android --variant release",
    "build:android:dev": "eas build --platform android --profile development",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:prod": "eas build --platform android --profile production",
    "submit:android:prod": "eas submit --platform android --profile production",
    "ios": "expo run:ios",
    "ios:dev": "expo run:ios",
    "web": "expo start --web",
    "lint": "biome lint App.tsx src server .github package.json biome.json",
    "lint:fix": "biome check --write App.tsx src server .github package.json biome.json",
    "test": "bun test",
    "test:e2e": "bun test server/src/app/startServer.e2e.test.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.8",
    "@react-navigation/native": "^7.2.1",
    "@react-navigation/native-stack": "^7.14.10",
    "@types/react": "~19.1.10",
    "expo": "^54.0.0",
    "expo-av": "~16.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-notifications": "~0.32.16",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "openai": "^6.33.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webrtc": "^124.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@config-plugins/react-native-webrtc": "^13.0.0",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^25.5.2",
    "bun-types": "^1.3.11",
    "cross-env": "^10.1.0",
    "eas-cli": "^18.4.0",
    "typescript": "~5.9.2"
  },
  "packageManager": "bun@1.3.11",
  "private": true
}
